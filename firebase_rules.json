{
  "rules": {
    "users": {
      ".read": true,
      "$uid": {
        ".write": true,
        ".validate": "newData.hasChildren(['user', 'name', 'password'])"
      }
    },
    "messages": {
      ".read": true,
      ".write": true,
      "$messageId": {
        ".validate": "newData.hasChildren(['uid', 'name', 'txt', 'time'])"
      }
    },
    "ai_config": {
      ".read": true,
      ".write": "newData.child('_authToken').val() === root.child('_adminAuth/token').val() && root.child('_adminAuth/token').val() != null",
      ".validate": "newData.hasChildren(['name', 'model', '_authToken'])"
    },
    "_adminAuth": {
      ".read": false,
      ".write": true,
      ".validate": "newData.hasChildren(['token', 'timestamp'])"
    },
    "typing": {
      ".read": true,
      ".write": true
    },
    "pinnedMessage": {
      ".read": true,
      ".write": true
    },
    "bannedNotifications": {
      ".read": true,
      ".write": true
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
